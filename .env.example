DB_HOST=student-db.ch6y0o2gu511.ap-south-1.rds.amazonaws.com
DB_USER=admin
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=student_db
# Required: random string of 32+ characters. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-a-long-random-value-and-paste-it-here

# AI course insights (free). Get a key at https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Alternative: AI_PROVIDER=groq with GROQ_API_KEY=... and GROQ_MODEL=llama-3.1-8b-instant
# Optional limits: AI_USER_HOURLY_LIMIT=5  AI_DAILY_LIMIT=20  AI_CACHE_DAYS=30
# Seconds to wait for the AI service: AI_TIMEOUT=40
